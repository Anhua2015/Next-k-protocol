# 复制为 Next-k-protocol/.env.oi（本地开发）或写入 Railway 环境变量
# =====================

# ── 服务端口 ─────────────────────────────────────────────────────
# PORT=8001

# ── 鉴权（生产环境必须设置）──────────────────────────────────────
# 所有 /api/binance/* 接口（除 /api/binance/health）都需要此 token
# 请求时通过 X-Maintenance-Token header 或 Authorization: Bearer <token> 传递
PROTOCOL_MAINTENANCE_TOKEN=your-secret-token-here

# ── 币安 API ─────────────────────────────────────────────────────
# 也可通过 POST /api/binance/config 在运行时写入 DB
# BINANCE_API_KEY=your-binance-api-key
# BINANCE_API_SECRET=your-binance-api-secret
# BINANCE_TESTNET=false

# ── 交易参数 ─────────────────────────────────────────────────────
# BINANCE_MARGIN_USDT=100              # 单笔保证金（USDT）
# BINANCE_LEVERAGE=10                  # 杠杆倍数
# BINANCE_MAX_POSITIONS=8              # 全局最大持仓数
# BINANCE_MAX_POSITIONS_PLAY01=5       # PLAY01 最大持仓数
# BINANCE_MAX_POSITIONS_PLAY02=5       # PLAY02 最大持仓数
# BINANCE_MAX_POSITIONS_PLAY03=5       # PLAY03 最大持仓数
# BINANCE_EXPIRE_HOURS=4               # 全局持仓过期时限（小时）
# BINANCE_EXPIRE_HOURS_PLAY01=5        # PLAY01 过期时限（小时）
# BINANCE_EXPIRE_HOURS_PLAY02=4        # PLAY02 过期时限（小时）
# BINANCE_EXPIRE_HOURS_PLAY03=3        # PLAY03 过期时限（小时）

# ── 数据目录 ─────────────────────────────────────────────────────
# Railway 挂载 Volume 时通常为 /data
# DATA_DIR=/data

# ── 内嵌调度器（默认开启）─────────────────────────────────────────
# EMBED_SCHEDULER=1
