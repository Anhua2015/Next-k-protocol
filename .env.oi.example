# 复制为 Next-k-protocol/.env.oi（本地开发）或写入 Railway 环境变量
# =====================

# ── 服务端口 ─────────────────────────────────────────────────────
# PORT=8001

# ── 币安 API ─────────────────────────────────────────────────────
# BINANCE_API_KEY=your-binance-api-key
# BINANCE_API_SECRET=your-binance-api-secret
# BINANCE_TESTNET=false                # 仅选择测试网/主网，不控制是否下单

# ── 敏感写接口鉴权 ──────────────────────────────────────────────
# 生产环境必须设置；next-k-api 需配置相同值
# PROTOCOL_MAINTENANCE_TOKEN=replace-with-a-long-random-token

# ── CORS ─────────────────────────────────────────────────────────
# 逗号分隔；留空时保持兼容开放，生产建议明确配置
# PROTOCOL_CORS_ORIGINS=https://your-dashboard.vercel.app

# ── 入场滑点保护 ─────────────────────────────────────────────────
# 默认 LIMIT_FOK：要么在最大滑点内完全成交，要么直接过期，不留下挂单
# 如需恢复旧市价行为，设置 PROTOCOL_ENTRY_ORDER_TYPE=MARKET
# PROTOCOL_ENTRY_ORDER_TYPE=LIMIT_FOK
# PROTOCOL_MAX_ENTRY_SLIPPAGE_BPS=20
# PROTOCOL_MAX_ENTRY_SPREAD_BPS=0
# PROTOCOL_MARKET_ENTRY_FALLBACK=false

# ── 净盈亏自动同步 ───────────────────────────────────────────────
# 数据源为 Binance /fapi/v1/income；本地缓存后用于日/周/月净盈亏可视化
# PROTOCOL_PNL_AUTO_SYNC_ENABLED=true
# PROTOCOL_PNL_STARTUP_SYNC_DAYS=7
# PROTOCOL_PNL_INCREMENTAL_SYNC_DAYS=3
# PROTOCOL_PNL_INCREMENTAL_SYNC_INTERVAL_SEC=1800
# PROTOCOL_PNL_FULL_SYNC_DAYS=90
# PROTOCOL_PNL_FULL_SYNC_INTERVAL_SEC=86400

# 交易开关、持仓上限、保证金/杠杆等由 next-k-api 信号控制。
# ORB 侧示例：ORB_LIVE_ENABLED=1

# ── 数据目录 ─────────────────────────────────────────────────────
# Railway 挂载 Volume 时通常为 /data
# DATA_DIR=/data
