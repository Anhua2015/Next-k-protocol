# 复制为 Next-k-protocol/.env.oi（本地开发）或写入 Railway 环境变量
# =====================

# ── 服务端口 ─────────────────────────────────────────────────────
# PORT=8001

# ── 币安 API ─────────────────────────────────────────────────────
# BINANCE_API_KEY=your-binance-api-key
# BINANCE_API_SECRET=your-binance-api-secret
# BINANCE_TESTNET=false                # 仅选择测试网/主网，不控制是否下单

# 交易开关、入场类型、持仓上限、保证金/杠杆等由 next-k-api 信号控制。
# ORB 侧示例：ORB_LIVE_ENABLED=1

# ── 数据目录 ─────────────────────────────────────────────────────
# Railway 挂载 Volume 时通常为 /data
# DATA_DIR=/data

# ── 内嵌调度器（默认开启）─────────────────────────────────────────
# EMBED_SCHEDULER=1

# ── Next K 网格总控台（实现目录 vendor/wangge，Bitget）──────────────
# WANGGE_ENABLED=1
# WANGGE_PORT=8080
# WANGGE_REQUIRED=1
# API 密钥写在 vendor/wangge/.env（见 vendor/wangge/.env.example）
