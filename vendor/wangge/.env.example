# ═══════════════════════════════════════════════════════════
# Bitget 多标的网格 · 配置文件
# 复制为 .env 后填写
# ═══════════════════════════════════════════════════════════

PORT=8080
HOST=127.0.0.1

# paper 初始余额（多标的共享同一 Bitget 账户）
PAPER_BALANCE=10000

# ── 代理 ──────────────────────────────────────────────────
GLOBAL_PROXY=
BITGET_PROXY=

# ── Bitget（USDT 永续）────────────────────────────────────
BG_MODE=paper
BG_NETWORK=mainnet

# 标的：逗号分隔，一标的一机器人
# 例：BG_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BG_SYMBOLS=BTCUSDT

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_API_URL=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_MODE=crossed

# ── AI（可选）─────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_SMALL=
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
