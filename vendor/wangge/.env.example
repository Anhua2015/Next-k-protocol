# ═══════════════════════════════════════════════════════════
# Next K 网格（Bitget 多标的）· 配置文件
# 复制为 .env 后填写
# ═══════════════════════════════════════════════════════════

PORT=8080
HOST=127.0.0.1

# paper 初始余额（多标的共享同一 Bitget 账户）
PAPER_BALANCE=15000

# ── 代理 ──────────────────────────────────────────────────
GLOBAL_PROXY=
BITGET_PROXY=

# ── Bitget（USDT 永续）────────────────────────────────────
BG_MODE=paper
BG_NETWORK=mainnet

# 标的：逗号分隔；留空则完全交给选币官 / 界面添加（不种子 BTC）
# 例：BG_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BG_SYMBOLS=

# 持久化目录（Railway 挂 Volume 到 /data 时务必设置）
# 网格快照 → $DATA_DIR/wangge.state.json
# 标的名单 → $DATA_DIR/wangge_symbols.txt
# Paper 账本 → $DATA_DIR/wangge_paper.json
# DATA_DIR=/data
# 也可单独指定：WANGGE_DATA_DIR=/data

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_API_URL=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_MODE=crossed

# ── 选币官（自动维护候选池与机器人去留）────────────────
# 默认开启；设为 0 关闭
SCOUT_ENABLED=1
SCOUT_MAX_BOTS=3
# 巡检间隔毫秒（默认 2 小时；偏长以减少换仓）
SCOUT_INTERVAL_MS=7200000
# 可选：最短持有后再淘汰（默认 6 小时）
# SCOUT_MIN_HOLD_MS=21600000
# 白名单（逗号分隔；留空用内置默认：仅 BTC/ETH/SOL）
# 核心：达 scoreIn 即可进场；次核心：需更高分 + 震荡/弱趋势
# SCOUT_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT
# SCOUT_ALLOWLIST_SECONDARY=
# SCOUT_SCORE_IN_SECONDARY=0.76

# ── AI（可选）─────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_SMALL=
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
